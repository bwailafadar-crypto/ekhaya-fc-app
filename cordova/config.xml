<?xml version='1.0' encoding='utf-8'?>
<widget id="mw.ekhayafc.app" version="1.1.0" android-versionCode="10100" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Ekhaya FC</name>
    <description>Ekhaya FC official app</description>
    <author>Ekhaya FC</author>
    <content src="index.html" />
    <preference name="Orientation" value="portrait" />
    <preference name="GradleVersion" value="8.10.2" />
    <preference name="AndroidGradlePluginVersion" value="8.7.3" />
    <preference name="android-buildToolsVersion" value="35.0.0" />
    <preference name="android-targetSdkVersion" value="35" />
    <preference name="android-compileSdkVersion" value="35" />
    <preference name="AndroidWindowSplashScreenBackground" value="#11140F" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/icon.png" />
    <!-- Load the live website so new features reach fans without a new APK. -->
    <access origin="*" />
    <allow-navigation href="https://ekhaya-fc-app.web.app/*" />
    <allow-navigation href="https://ekhaya-fc-app.firebaseapp.com/*" />
    <allow-navigation href="https://ekhayafc-app.netlify.app/*" />
    <!-- PayChangu checkout opens inside the app and returns to the live site. -->
    <allow-navigation href="https://paychangu.com/*" />
    <allow-navigation href="https://*.paychangu.com/*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />
    <preference name="AppendUserAgent" value="EkhayaFCApp/1.0" />
    <preference name="ErrorUrl" value="https://localhost/offline.html" />
    <preference name="LoadUrlTimeoutValue" value="30000" />
    <hook type="after_prepare" src="hooks/after_prepare/010-android-gradle-properties.js" />
    <platform name="android">
        <icon density="ldpi" src="resources/android/icon/drawable-ldpi-icon.png" />
        <icon density="mdpi" src="resources/android/icon/drawable-mdpi-icon.png" />
        <icon density="hdpi" src="resources/android/icon/drawable-hdpi-icon.png" />
        <icon density="xhdpi" src="resources/android/icon/drawable-xhdpi-icon.png" />
        <icon density="xxhdpi" src="resources/android/icon/drawable-xxhdpi-icon.png" />
        <icon density="xxxhdpi" src="resources/android/icon/drawable-xxxhdpi-icon.png" />
    </platform>
</widget>

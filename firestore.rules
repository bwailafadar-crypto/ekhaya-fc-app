rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasRole(expectedRole) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == expectedRole;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('superadmin');
    }

    function isSuperadmin() {
      return hasRole('superadmin');
    }

    function validRole(role) {
      return role in ['fan', 'admin', 'superadmin'];
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'role', 'email', 'fullName', 'phone', 'legacyFanDocId',
          'legacyFanId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'role', 'email', 'fullName', 'phone', 'legacyFanDocId',
          'legacyFanId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'fan'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 120
        && (request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
        && (request.resource.data.legacyFanDocId == null || request.resource.data.legacyFanDocId is string)
        && (request.resource.data.legacyFanId == null || request.resource.data.legacyFanId is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get: if signedIn() && (request.auth.uid == uid || isSuperadmin());
      allow list: if isSuperadmin();

      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && resource.data.role == request.resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'photoDataUrl', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName'])
            || (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 120))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
            || request.resource.data.phone == null
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoDataUrl'])
            || request.resource.data.photoDataUrl == null
            || (request.resource.data.photoDataUrl is string && request.resource.data.photoDataUrl.size() <= 700000))
        ) || (
          isSuperadmin()
          && request.auth.uid != uid
          && validRole(request.resource.data.role)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'disabled', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled']) || request.resource.data.disabled is bool)
        );

      allow delete: if isSuperadmin() && request.auth.uid != uid;
    }

    match /fans/{fanDocId} {
      allow get, list: if signedIn()
        && (isSuperadmin() || resource.data.email == request.auth.token.email);
      allow create, update, delete: if isSuperadmin();
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /fixtures/{fixtureId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }

      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['emoji', 'updatedAt'])
          && request.resource.data.emoji in ['⚽', '🔥', '👏', '😱'];
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /standings/{standingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /news/{newsId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();

      match /photos/{photoId} {
        allow get, list: if isAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/news/$(newsId)).data.status == 'published');
        allow create, update, delete: if isAdmin();
      }
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /membershipTiers/{tierId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /memberships/{membershipId} {
      allow get: if signedIn()
        && (membershipId == request.auth.uid || isSuperadmin());
      allow list: if isSuperadmin();
      allow create: if signedIn()
        && membershipId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'tierId', 'fullName', 'phone', 'email', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'tierId', 'fullName', 'phone', 'email', 'status', 'createdAt'
        ])
        && request.resource.data.tierId is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 32
        && exists(/databases/$(database)/documents/membershipTiers/$(request.resource.data.tierId))
        && get(/databases/$(database)/documents/membershipTiers/$(request.resource.data.tierId)).data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isSuperadmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperadmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
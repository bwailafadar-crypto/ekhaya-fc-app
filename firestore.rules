rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasRole(expectedRole) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == expectedRole;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('superadmin');
    }

    function isSuperadmin() {
      return hasRole('superadmin');
    }

    // A fan who may take part (vote, predict, react): signed in, email
    // verified, and not blocked by the club. Blocking is enforced here, not
    // only in the app.
    function isBlocked() {
      return exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('disabled', false) == true;
    }

    function canAct() {
      return signedIn()
        && request.auth.token.email_verified == true
        && !isBlocked();
    }

    function myName() {
      return get(userPath(request.auth.uid)).data.get('fullName', '');
    }

    function fixtureDoc(fixtureId) {
      return get(/databases/$(database)/documents/fixtures/$(fixtureId)).data;
    }

    // Fans cannot pose as the club or its staff in their display name.
    function validFanName(name) {
      return !name.lower().matches('.*(ekhaya|official|admin|club|management).*');
    }

    function validRole(role) {
      return role in ['fan', 'admin', 'superadmin'];
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'role', 'email', 'fullName', 'phone', 'legacyFanDocId',
          'legacyFanId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'role', 'email', 'fullName', 'phone', 'legacyFanDocId',
          'legacyFanId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'fan'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 120
        && validFanName(request.resource.data.fullName)
        && (request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
        // Old fan records are linked by the club, never by the fan themselves.
        && request.resource.data.legacyFanDocId == null
        && request.resource.data.legacyFanId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get: if signedIn() && (request.auth.uid == uid || isSuperadmin());
      allow list: if isSuperadmin();

      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && resource.data.role == request.resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'photoDataUrl', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName'])
            || (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 120
              && validFanName(request.resource.data.fullName)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
            || request.resource.data.phone == null
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoDataUrl'])
            || request.resource.data.photoDataUrl == null
            || (request.resource.data.photoDataUrl is string && request.resource.data.photoDataUrl.size() <= 700000))
        ) || (
          isSuperadmin()
          && request.auth.uid != uid
          && validRole(request.resource.data.role)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'disabled', 'legacyFanDocId', 'legacyFanId', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled']) || request.resource.data.disabled is bool)
        );

      allow delete: if isSuperadmin() && request.auth.uid != uid;
    }

    match /fans/{fanDocId} {
      // Old member records: only the superadmin, or the owner of a VERIFIED
      // matching email (so nobody can sign up with someone else's address).
      allow get, list: if signedIn()
        && (isSuperadmin()
          || (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email));
      allow create, update, delete: if isSuperadmin();
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /fixtures/{fixtureId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }

      // Fan Zone: one score prediction per fan, only before kick-off.
      match /predictions/{uid} {
        allow read: if signedIn();
        allow create, update: if canAct()
          && request.auth.uid == uid
          && fixtureDoc(fixtureId).status == 'upcoming'
          && fixtureDoc(fixtureId).get('predictionsLocked', false) != true
          && fixtureDoc(fixtureId).get('isTest', false) != true
          && request.resource.data.keys().hasOnly(['home', 'away', 'name', 'updatedAt'])
          && request.resource.data.keys().hasAll(['home', 'away', 'name', 'updatedAt'])
          && request.resource.data.home is int
          && request.resource.data.home >= 0 && request.resource.data.home <= 20
          && request.resource.data.away is int
          && request.resource.data.away >= 0 && request.resource.data.away <= 20
          // The name shown on the leaderboard is the fan's real profile name.
          && request.resource.data.name == myName()
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }

      // Fan Zone: one man-of-the-match vote per fan after a real match,
      // until an admin closes voting.
      match /motm/{uid} {
        allow read: if signedIn();
        allow create, update: if canAct()
          && request.auth.uid == uid
          && fixtureDoc(fixtureId).status == 'finished'
          && fixtureDoc(fixtureId).get('isTest', false) != true
          && fixtureDoc(fixtureId).get('motmClosed', false) != true
          && request.resource.data.keys().hasOnly(['playerId', 'updatedAt'])
          && request.resource.data.keys().hasAll(['playerId', 'updatedAt'])
          && request.resource.data.playerId is string
          && exists(/databases/$(database)/documents/players/$(request.resource.data.playerId))
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }

      // Stadium check-in: one per fan per match, from team news until full time.
      match /checkins/{uid} {
        allow read: if signedIn();
        allow create: if canAct()
          && request.auth.uid == uid
          && fixtureDoc(fixtureId).get('isTest', false) != true
          && fixtureDoc(fixtureId).get('editing', false) != true
          && (fixtureDoc(fixtureId).status == 'live'
            || (fixtureDoc(fixtureId).status == 'upcoming' && fixtureDoc(fixtureId).get('lineupConfirmed', false) == true))
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name == myName()
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin();
      }

      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if canAct()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['emoji', 'updatedAt'])
          && request.resource.data.emoji in ['⚽', '🔥', '👏', '😱']
          && exists(/databases/$(database)/documents/fixtures/$(fixtureId))
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /standings/{standingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      // Removing a player from the squad is a superadmin power.
      allow delete: if isSuperadmin();
    }

    match /news/{newsId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();

      match /photos/{photoId} {
        allow get, list: if isAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/news/$(newsId)).data.status == 'published');
        allow create, update, delete: if isAdmin();
      }
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      // Fan Zone: one vote per fan while the poll is open.
      match /votes/{uid} {
        allow read: if signedIn();
        allow create, update: if canAct()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['option', 'updatedAt'])
          && request.resource.data.keys().hasAll(['option', 'updatedAt'])
          && request.resource.data.option is int
          && request.resource.data.option >= 0
          && request.resource.data.option < get(/databases/$(database)/documents/polls/$(pollId)).data.options.size()
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }
    }

    // Season leaderboard, calculated by admins after each match so fans read
    // one small document instead of every prediction ever made.
    match /leaderboard/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Fan points and level, calculated by admins (fans never write their own).
    match /fanPoints/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaderboardEntries/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /membershipTiers/{tierId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /memberships/{membershipId} {
      allow get: if signedIn()
        && (membershipId == request.auth.uid || isSuperadmin());
      allow list: if isSuperadmin();
      allow create: if signedIn()
        && membershipId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'tierId', 'fullName', 'phone', 'email', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'tierId', 'fullName', 'phone', 'email', 'status', 'createdAt'
        ])
        && request.resource.data.tierId is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 32
        && exists(/databases/$(database)/documents/membershipTiers/$(request.resource.data.tierId))
        && get(/databases/$(database)/documents/membershipTiers/$(request.resource.data.tierId)).data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isSuperadmin();
    }

    // Push alerts: each device stores its own token and alert choices.
    // Only the server functions (admin access) read the full list.
    match /pushTokens/{tokenId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == tokenId
        && tokenId.size() >= 100 && tokenId.size() <= 400
        && request.resource.data.keys().hasOnly(['uid', 'token', 'prefs', 'platform', 'follows', 'updatedAt'])
        // Players this fan follows (goal alerts for them), at most 30.
        && (!('follows' in request.resource.data) || (request.resource.data.follows is list && request.resource.data.follows.size() <= 30))
        && request.resource.data.prefs is map
        && request.resource.data.prefs.keys().hasOnly(['match', 'news'])
        && request.resource.data.prefs.match is bool
        && request.resource.data.prefs.news is bool
        && request.resource.data.platform in ['android', 'ios', 'desktop']
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Free push alerts: the GitHub key that lets admin apps ask GitHub to
    // send an alert. Admins can use it; only the superadmin can change it.
    match /adminConfig/{configId} {
      allow read: if isAdmin();
      allow write: if isSuperadmin();
    }

    // One record per alert, so it is sent once even if several admins have
    // the app open. Create-only: a second attempt is refused.
    // Fan Family: each fan's public name + district branch (name must match their profile).
    match /fanCards/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && !isBlocked()
        && request.resource.data.keys().hasOnly(['name', 'branch', 'updatedAt'])
        && request.resource.data.name == myName()
        && request.resource.data.branch in ['balaka','blantyre','chikwawa','chiradzulu','chitipa','dedza','dowa','karonga','kasungu','likoma','lilongwe','machinga','mangochi','mchinji','mulanje','mwanza','mzimba-mzuzu','neno','nkhata-bay','nkhotakota','nsanje','ntcheu','ntchisi','phalombe','rumphi','salima','thyolo','zomba','outside-malawi']
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (request.auth.uid == uid || isSuperadmin());
    }

    // Who invited whom. Only a new, verified fan can say who invited them, once.
    match /referrals/{uid} {
      allow create: if canAct()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'createdAt'])
        && request.resource.data.by is string
        && request.resource.data.by != uid
        && exists(userPath(request.resource.data.by))
        && get(userPath(uid)).data.createdAt > request.time - duration.value(7, 'd')
        && request.resource.data.createdAt == request.time;
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if false;
      allow delete: if isSuperadmin();
    }

    match /communityStats/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Shared public data for fans (fixtures, table, teams in one document).
    // Built by admin apps and the GitHub workflows.
    match /publicData/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Feature flags and the club-wide notice. Only the superadmin changes them.
    match /appConfig/{docId} {
      allow read: if signedIn();
      allow write: if isSuperadmin()
        && request.resource.data.keys().hasOnly(['flags', 'notice', 'updatedAt'])
        && request.resource.data.flags is map
        && request.resource.data.notice is string
        && request.resource.data.notice.size() <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // Errors fans hit, for Admin -> App health. Write-only for fans.
    match /clientErrors/{errorId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'context', 'message', 'code', 'stack', 'path', 'build', 'env', 'agent', 'createdAt'])
        && request.resource.data.context is string && request.resource.data.context.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.code is string && request.resource.data.code.size() <= 80
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.path is string && request.resource.data.path.size() <= 120
        && request.resource.data.build is string && request.resource.data.build.size() <= 40
        && request.resource.data.env is string && request.resource.data.env.size() <= 20
        && request.resource.data.agent is string && request.resource.data.agent.size() <= 160
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Home stories: posted by admins, shown to signed-in fans for 24 hours.
    // The small thumbnail lives on the story; the full photo is in storyImages.
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['caption', 'label', 'thumb', 'hasImage', 'path', 'createdAt', 'expiresAt', 'by'])
        && request.resource.data.keys().hasAll(['caption', 'label', 'hasImage', 'createdAt', 'expiresAt', 'by'])
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 160
        && request.resource.data.label in ['Team news', 'Match day', 'Goal', 'Training', 'Club']
        && request.resource.data.hasImage is bool
        && (!('thumb' in request.resource.data) || request.resource.data.thumb == null || (request.resource.data.thumb is string && request.resource.data.thumb.size() <= 30000))
        && (!('path' in request.resource.data) || (request.resource.data.path is string && request.resource.data.path.size() <= 120))
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'd')
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /storyImages/{storyId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['image', 'createdAt'])
        && request.resource.data.image is string && request.resource.data.image.size() <= 400000
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    match /alertsSent/{alertId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.createdAt == request.time;
      // An admin removes the record again if sending failed, so it can retry.
      allow delete: if isAdmin();
      allow read, update: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperadmin();
      // Not used by the app; closed so nothing can be dumped here.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
{
  "name": "ekhaya-fc-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:android": "node scripts/copy-android-www.mjs && cd cordova && JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 CORDOVA_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 PATH=\"$HOME/.local/gradle/8.14.2/gradle-8.14.2/bin:/usr/lib/jvm/java-17-openjdk-amd64/bin:$PATH\" cordova build android",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "seed": "tsx scripts/seed.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ekhaya-rules \"tsx --test tests/firestore.rules.test.ts\"",
    "build:android:release": "node scripts/build-android-release.mjs",
    "deploy": "node scripts/deploy-firebase.mjs",
    "save-firebase-key": "node scripts/save-firebase-key.cjs",
    "check-data": "node scripts/audit-data.cjs",
    "cleanup-test-data": "node scripts/cleanup-test-data.cjs",
    "restore-fixtures": "node scripts/restore-real-fixtures.cjs",
    "deploy:direct": "node scripts/deploy-direct.cjs",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/unit/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:bundle": "node scripts/check-bundle.cjs",
    "snapshot": "node scripts/publish-snapshot.cjs",
    "smoke": "node scripts/smoke-test.cjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-ekhaya",
    "seed:emulator": "node scripts/seed-emulator.cjs",
    "dev:emulators": "VITE_USE_EMULATORS=true vite --host 0.0.0.0",
    "health": "node scripts/check-app.cjs",
    "form": "node scripts/fix-form.cjs",
    "compare": "node scripts/compare-data.cjs",
    "cleanup": "node scripts/purge-deleted.cjs",
    "build:android:play": "node scripts/build-android-release.mjs --bundle",
    "match-report": "node scripts/load-match-report.cjs",
    "kickoff-3pm": "node scripts/set-kickoff.cjs",
    "venue": "node scripts/set-venue.cjs",
    "table": "node scripts/sync-table.cjs",
    "move-match": "node scripts/move-match.cjs",
    "squad-dob": "node scripts/load-squad-dob.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "firebase": "^13.3.0",
    "lucide-react": "^1.72.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@netlify/functions": "^6.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.32.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
